# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-bootstrap-password
# Deployment-specific values belong only in the untracked .env file.
PUBLIC_BASE_URL=
ALLOWED_ORIGINS=
ALLOWED_HOSTS=
ENVIRONMENT=production
APP_PORT=8080
TOKEN_LIFETIME_HOURS=6
DEFAULT_VOTING_DURATION=60
CLEANUP_INTERVAL_MINUTES=15
TRAEFIK_ENABLED=false
TRAEFIK_HOST=
TRAEFIK_NETWORK=
TRAEFIK_ROUTER_NAME=
TRAEFIK_ENTRYPOINT=
TRAEFIK_CERTRESOLVER=
# Europe/Athens is the documented display/deployment timezone; timestamps are stored UTC.
TZ=Europe/Athens

