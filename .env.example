# Server Port (default: 3000)
PORT=3000

# Environment Mode (production or development)
NODE_ENV=production

# Administrator Initial Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# JWT Secret Key (Change this to a long random secret in production)
SECRET_KEY=ntua-voting-secret-key-production-replace-me

# Public Base URL of the application
PUBLIC_BASE_URL=https://voting.yourdomain.com