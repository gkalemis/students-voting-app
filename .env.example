# Generate with: openssl rand -hex 32
SECRET_KEY=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-bootstrap-password
PUBLIC_BASE_URL=https://ntua-civil-voting.kfm.gr
ALLOWED_ORIGINS=https://ntua-civil-voting.kfm.gr
ENVIRONMENT=production
APP_PORT=8080
TOKEN_LIFETIME_HOURS=6
DEFAULT_VOTING_DURATION=60
CLEANUP_INTERVAL_MINUTES=15
TRAEFIK_ENABLED=true
TRAEFIK_HOST=ntua-civil-voting.kfm.gr
TRAEFIK_CERTRESOLVER=letsencrypt
# Europe/Athens is the documented display/deployment timezone; timestamps are stored UTC.
TZ=Europe/Athens

